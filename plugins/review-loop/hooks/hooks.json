{
  "description": "review-loop hooks: the Stop hook keeps Claude working until the reviewer approves; the UserPromptSubmit hook records when a paused loop resumes",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/review-loop/scripts/stop-hook.sh\"",
            "timeout": 30,
            "statusMessage": "review-loop: checking loop state..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/review-loop/scripts/resume-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
